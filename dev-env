#!/usr/bin/env bash
set -euo pipefail
shopt -s nullglob

dry_run=0
if [[ "${1:-}" == "--dry" ]]; then
    dry_run=1
fi

XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
DEV_ENV="${DEV_ENV:-$HOME/dotfiles}"

log() {
    if [[ $dry_run == 1 ]]; then
        echo "[DRY_RUN]: $1"
    else
        echo "$1"
    fi
}

run() {
    log "$*"
    if [[ $dry_run == 0 ]]; then
        "$@"
    fi
}

update_files() {
    local src="$1" dest="$2"
    log "copying dirs from: $src"
    run mkdir -p "$dest"
    for dir in "$src"/*/; do
        local name
        name="$(basename "$dir")"
        run rm -rf "${dest%/}/$name"
        run cp -r "${dir%/}" "${dest%/}/$name"
    done
}

copy() {
    run rm -f "$2"
    run cp "$1" "$2"
}

log "env: $DEV_ENV"

update_files "$DEV_ENV/env/.config" "$XDG_CONFIG_HOME"
copy "$DEV_ENV/env/.zshrc" "$HOME/.zshrc"
copy "$DEV_ENV/env/.tmux.conf" "$HOME/.tmux.conf"

if command -v hyprctl > /dev/null && [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    run hyprctl reload
fi
